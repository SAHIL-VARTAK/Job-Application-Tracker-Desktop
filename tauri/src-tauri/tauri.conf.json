{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Application Tracker - Tauri",
  "version": "1.0.0",
  "identifier": "com.sahilvartak.jobapplicationtracker.tauri",
  "build": {
    "frontendDist": "../../workspace/Job-Application-Tracker-UI/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../workspace/Job-Application-Tracker-UI && npm run dev",
    "beforeBuildCommand": "cd ../workspace/Job-Application-Tracker-UI && npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/backend",
      "resources/runtime",
      "resources/splash"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
